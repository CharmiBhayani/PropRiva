{
  "pythonVersion": "3.11",
  "venvPath": ".",
  "venv": ".venv",
  "include": [
    "."
  ],
  "exclude": [
    ".venv",
    "**/__pycache__",
    "outputs"
  ],
  "extraPaths": [
    "."
  ],
  "typeCheckingMode": "basic",
  "reportMissingModuleSource": "none",
  "reportMissingImports": "none",
  "reportUndefinedVariable": "warning",
  "reportGeneralTypeIssues": "none"
}
