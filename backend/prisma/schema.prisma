generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}
enum LeaseStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

enum MaintenanceStatus {
  PENDING
  APPROVED_PAID_DIRECTLY
  APPROVED_RENT_ADJUSTED
  REJECTED
}

model User {
  id            Int      @id @default(autoincrement())

  name          String
  email         String   @unique
  password      String

  phone         String?
  avatar        String?
  occupation    String?
  dob           DateTime?

  role          Role     @default(USER)

  isVerified    Boolean  @default(false)

  ownedProperties Property[] @relation("OwnerProperties")

  leases Lease[]
  notifications Notification[]

  otp           String?
  otpExpiry     DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Property {
  id            Int      @id @default(autoincrement())

  title         String
  description   String?

  address       String
  city          String
  state         String
  pincode       String

  rentAmount    Float

  ownerId       Int

  owner User @relation("OwnerProperties", fields: [ownerId], references: [id])
  leases        Lease[]

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Lease {
  id            Int      @id @default(autoincrement())

  propertyId    Int
  tenantId      Int

  property Property @relation(fields: [propertyId], references: [id])

  tenant User @relation(fields: [tenantId], references: [id])

  status        LeaseStatus @default(PENDING)

  startDate     DateTime?
  endDate       DateTime?

  rentCredits   Float       @default(0)
  payments      Payment[]
  maintenanceRequests MaintenanceRequest[]

  createdAt     DateTime @default(now())
}

model Payment {
  id                 Int           @id @default(autoincrement())
  leaseId            Int
  lease              Lease         @relation(fields: [leaseId], references: [id])
  amount             Float
  status             PaymentStatus @default(PENDING)
  razorpayOrderId    String?       @unique
  razorpayPaymentId  String?       @unique
  razorpaySignature  String?
  paidAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model MaintenanceRequest {
  id              Int               @id @default(autoincrement())
  leaseId         Int
  lease           Lease             @relation(fields: [leaseId], references: [id])
  title           String
  description     String
  vendorName      String
  invoiceNo       String?
  billCode        String            @unique
  cost            Float
  status          MaintenanceStatus @default(PENDING)
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  message   String
  isRead    Boolean  @default(false)
  type      String
  createdAt DateTime @default(now())
}
